-- World.server.luau
-- Build 3D world with Parts: baseplate, 2 bases, road, conveyor, fence, trees, lamps, portal
local Workspace = game:GetService("Workspace")

local function createPart(name, size, cframe, color, material, anchored)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cframe
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Anchored = anchored ~= false
    p.CanCollide = true
    p.Parent = Workspace
    return p
end

-- Baseplate large
createPart("WorldBaseplate", Vector3.new(600,10,600), CFrame.new(0,-10,0), Color3.fromRGB(60,60,60), Enum.Material.SmoothPlastic, true)
-- Road middle
createPart("RoadMain", Vector3.new(300,2,30), CFrame.new(0,0,0), Color3.fromRGB(80,80,80), Enum.Material.Asphalt, true)
-- Conveyor belt
createPart("ConveyorBelt", Vector3.new(240,1,6), CFrame.new(0,1,0), Color3.fromRGB(40,40,40), Enum.Material.Metal, true)
-- Two player bases
local baseA = createPart("BaseA", Vector3.new(28,3,28), CFrame.new(-100,1.5,0), Color3.fromRGB(70,180,70), Enum.Material.Neon, true)
local baseB = createPart("BaseB", Vector3.new(28,3,28), CFrame.new(100,1.5,0), Color3.fromRGB(180,70,180), Enum.Material.Neon, true)
-- Base slots 6 per base
for i=1,6 do
    createPart("BaseA_Slot"..i, Vector3.new(3,0.5,3), CFrame.new(-100,0.5, -10 + (i-1)*4), Color3.fromRGB(30,30,30), Enum.Material.SmoothPlastic, true)
    createPart("BaseB_Slot"..i, Vector3.new(3,0.5,3), CFrame.new(100,0.5, -10 + (i-1)*4), Color3.fromRGB(30,30,30), Enum.Material.SmoothPlastic, true)
end
-- Fence around bases
for x=-120,-80,10 do
    createPart("FenceA_"..x, Vector3.new(1,4,30), CFrame.new(x,2,0), Color3.fromRGB(120,120,120), Enum.Material.Wood, true)
end
for x=80,120,10 do
    createPart("FenceB_"..x, Vector3.new(1,4,30), CFrame.new(x,2,0), Color3.fromRGB(120,120,120), Enum.Material.Wood, true)
end
-- Trees
for i=1,8 do
    local x = math.random(-200,200)
    local z = math.random(-200,200)
    createPart("Tree"..i, Vector3.new(5,12,5), CFrame.new(x,6,z), Color3.fromRGB(40,120,40), Enum.Material.Wood, true)
end
-- Lamps
for i=1,10 do
    local ang = i * math.rad(36)
    local r = 150
    local x = math.cos(ang)*r
    local z = math.sin(ang)*r
    createPart("Lamp"..i, Vector3.new(2,10,2), CFrame.new(x,5,z), Color3.fromRGB(255,240,180), Enum.Material.Neon, true)
end
-- Shop
createPart("Shop", Vector3.new(24,12,24), CFrame.new(0,6,-60), Color3.fromRGB(255,200,50), Enum.Material.SmoothPlastic, true)
-- Portal decoration
createPart("Portal", Vector3.new(8,8,8), CFrame.new(0,4,60), Color3.fromRGB(150,50,255), Enum.Material.Neon, true)

